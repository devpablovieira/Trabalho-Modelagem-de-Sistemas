@startuml SistemaGestao

class Administrador {
    -nome: String
    -usuario: String
    -senha: String
    -numeroWhatsapp: String
    +autenticar(usuario: String, senha: String): boolean
}

class Produto {
    -nome: String
    -descricao: String
    -tipo: String
    -imagens: List<String>
    -ativo: boolean  
    ' +cadastrarProduto()
    ' +visualizarProduto()
    ' +atualizarProduto()
    ' +excluirProduto()
    +inativar(): void
    +adicionarItemFicha(material: Material, qtd: double): void

}

class ItemFichaTecnica {
    -quantidadePorUnidade: double
    ' +visualizarFicha()
}

class Material {
    -nome: String
    -quantidade: double
    -unidadeMedida: String
    -estoqueMinimo: double  
    -ativo: boolean
    ' +cadastrarMaterial()
    ' +visualizarMaterial()
    ' +atualizarMaterial()
    ' +excluirMaterial()
    +inativar(): void
    +baixarEstoque(qtd: double): void
    +possuiSaldo(qtd: double): boolean
}

class Venda {
    -quantidade: int
    -valor: double
    -data: Date
    +registrarVenda(aceitarSaldoNegativo: boolean): void
}

Produto "1..1" *-- "1..*" ItemFichaTecnica : possui >
ItemFichaTecnica "0..*" --> "1..1" Material : usa >
Venda "0..*" --> "1..1" Produto : referente a >
@enduml